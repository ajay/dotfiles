#!/usr/bin/env bash
#
# ajay-workspace-setup
#
# Automated workspace layout for Fedora Linux (GNOME, X11 or Wayland).
# Launches applications and tiles their windows across monitors and
# workspaces using a Tactile-style grid reference system.
#
# This script ships a small GNOME Shell extension that provides a D-Bus
# API for window positioning. The extension is automatically installed
# and enabled on first run.
#
# Dependencies: jq, gdbus (glib2), gnome-extensions (gnome-shell)
#   Install:  sudo dnf install jq glib2 gnome-shell
#
# Usage:
#   ajay-workspace-setup                       Set up workspace (auto-pick layout by monitor count)
#   ajay-workspace-setup --layout NAME         Use a specific layout (e.g. dual, single)
#   ajay-workspace-setup --reset               Close windows from the last run, then set up
#   ajay-workspace-setup --reset-all           Close EVERY window (except this one), then set up
#   ajay-workspace-setup --close-all-windows   Close every window; do not lay out
#   ajay-workspace-setup --install             Install the helper extension only
#   ajay-workspace-setup --help                Show usage
#
set -euo pipefail

# ══════════════════════════════════════════════════════════════════════════════
#                              CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════
#
# Tactile grid (4 cols x 2 rows, equal size):
#
#   ┌───┬───┬───┬───┐
#   │ Q │ W │ E │ R │  row 0
#   ├───┼───┼───┼───┤
#   │ A │ S │ D │ F │  row 1
#   └───┴───┴───┴───┘
#    c0  c1  c2  c3
#
# Position = START-END  (top-left cell → bottom-right cell)
#
#   Q-F  full screen        Q-S  left half       E-F  right half
#   Q-W  top-left 1/4       E-R  top-right 1/4   A-S  bottom-left 1/4
#   D-F  bottom-right 1/4   Q-R  top half        A-F  bottom half
#
# LAYOUT entries:  "WORKSPACE:MONITOR:POSITION:COMMAND"
#
#   WORKSPACE  1-based workspace number
#   MONITOR    0-based monitor position (0 = leftmost, 1 = next, ...)
#   POSITION   Tactile grid reference
#   COMMAND    Shell command to launch the application. For terminals use the
#              helpers defined below — they handle the fish/eval quoting:
#                $(terminal)                plain terminal
#                $(terminal CMD)            CMD typed at the prompt, not run
#                $(terminal_run CMD)        CMD echoed and executed
#              Both take an optional starting directory as a second argument;
#              pass '' for the command to get a plain terminal in a directory:
#                $(terminal CMD DIR)  $(terminal_run CMD DIR)  $(terminal '' DIR)
#              Commands shared between layouts are defined once as CMD_*
#              constants just above the layout arrays.
#
# Layouts are declared as bash arrays named LAYOUT_<NAME> (uppercase).
# To add a layout, declare another array; --layout <name> will pick it up
# automatically (matching is case-insensitive). DEFAULT_LAYOUT_BY_MONITORS
# below maps detected monitor count -> layout name used when --layout is
# omitted; an unmapped count is an error.
# ──────────────────────────────────────────────────────────────────────────────

# Quote a string for a fish single-quoted context (fish escapes only \ and ').
fish_quote() {
    local s=${1//\\/\\\\}
    s=${s//\'/\\\'}
    printf "'%s'" "$s"
}

# ptyxis invocation with an optional starting directory and fish init command.
# --working-directory is why neither helper emits a `cd`: cd is a fish function,
# so fish_trace descends into it and buries the real command in ~25 lines.
# It is always passed, defaulting to $HOME: a ptyxis window without it inherits
# the cwd of whatever launched the script, so running this from a repo would
# otherwise start every terminal there -- including the claude ones, which must
# be in $HOME or their auto-memory store is keyed to the wrong project path.
# %q carries the init through the eval in launch_and_find_window, and ptyxis's
# `--` form passes argv on unparsed, so that is the only quoting layer.
# `-- fish` is what a default ptyxis window already runs here (fish is the login
# shell, login-shell=false); the shell stays interactive after -C, so the window
# does not close.
_ptyxis() {
    local dir="${1:-$HOME}" init="${2:-}" out='ptyxis --new-window'
    if [[ "$dir" == "~"* ]]; then dir="$HOME${dir#\~}"; fi
    out+=" --working-directory=$(printf '%q' "$dir")"
    if [[ -n "$init" ]]; then
        out+=" -- fish -C $(printf '%q' "$init")"
    fi
    printf '%s' "$out"
}

# Terminal with CMD typed into the prompt but NOT run, optionally starting in DIR.
terminal() {
    local cmd="${1:-}" dir="${2:-}" init=""
    if [[ -n "$cmd" ]]; then
        init="commandline $(fish_quote "$cmd")"
    fi
    _ptyxis "$dir" "$init"
}

# Terminal that echoes CMD after a prompt and runs it under fish_trace,
# optionally starting in DIR. CMD runs inside a throwaway function so the trace
# flag is function-local and dies with the call: `set fish_trace 0` does NOT turn
# tracing off, because fish traces on any non-empty value, "0" included.
terminal_run() {
    local cmd="${1:-}" dir="${2:-}"
    if [[ -z "$cmd" ]]; then
        terminal "" "$dir"
        return
    fi
    local init="function __ajay_run; set -l fish_trace 1; $cmd; end"
    init+="; fish_prompt && echo $(fish_quote "$cmd")"
    init+="; __ajay_run; functions -e __ajay_run"
    _ptyxis "$dir" "$init"
}

# ── Named launch commands ─────────────────────────────────────────────────────
# One complete COMMAND string per entry, shared by every layout below.

CMD_ADB_DEVICES=$(terminal 'adb-devices')
CMD_ADB_SHELL=$(terminal 'adb-root-remount-shell')
CMD_BROWSER_MAIL="fish -c 'google-chrome-open-bookmark-folder mail'"
CMD_BROWSER_WORK="fish -c 'google-chrome-open-bookmark-folder work-start'"
CMD_CLAUDE_DOTFILES=$(terminal_run 'claude /ajay-init-dotfiles')
CMD_CLAUDE_FLOCKBOSS=$(terminal_run 'claude /ajay-init-flockboss')
CMD_DOTFILES_STATUS=$(terminal_run 'git status' ~/.dotfiles)
CMD_EDITOR="subl --launch-or-new-window"
CMD_FBSOURCE_SYNC=$(terminal_run 'dev doctor && eden doctor && fish_trace= cd ~/fbsource && hg pull && hg cloud sync --full && hg st && hg fssl --pager=no')
CMD_FLOCKBOSS_FLASH=$(terminal 'cd ~/fbsource && rr make -C ~/fbsource/arvr/firmware/projects/flockboss/firmware/apps/syncboss/ BOARD=loma_evt2 flash-fwmgmt')

LAYOUT_DUAL=(
    # ── Workspace 1: browser ──────────────────────────────────────────────────
    "1:0:Q-F:$CMD_BROWSER_WORK"

    # ── Workspace 2: flockboss firmware ───────────────────────────────────────
    "2:0:Q-S:$CMD_EDITOR"
    "2:0:E-F:$CMD_CLAUDE_FLOCKBOSS"
    "2:1:Q-W:$CMD_FLOCKBOSS_FLASH"
    "2:1:E-R:$CMD_ADB_SHELL"
    "2:1:A-S:$CMD_FBSOURCE_SYNC"
    "2:1:D-F:$CMD_ADB_DEVICES"

    # ── Workspace 3: scratch terminals ────────────────────────────────────────
    "3:0:Q-S:$(terminal)"
    "3:0:E-F:$(terminal)"

    # ── Workspace 5: dotfiles ─────────────────────────────────────────────────
    "5:0:Q-S:$CMD_CLAUDE_DOTFILES"
    "5:0:E-F:$CMD_DOTFILES_STATUS"

    # ── Workspace 6: browser ──────────────────────────────────────────────────
    "6:1:Q-F:$CMD_BROWSER_MAIL"
)

LAYOUT_SINGLE=(
    # ── Workspace 1: browser ──────────────────────────────────────────────────
    "1:0:Q-F:$CMD_BROWSER_WORK"

    # ── Workspace 2: editor ───────────────────────────────────────────────────
    "2:0:Q-S:$CMD_EDITOR"
    "2:0:E-F:$CMD_CLAUDE_FLOCKBOSS"

    # ── Workspace 3: terminals ────────────────────────────────────────────────
    "3:0:Q-W:$CMD_FLOCKBOSS_FLASH"
    "3:0:E-R:$CMD_ADB_SHELL"
    "3:0:A-S:$CMD_FBSOURCE_SYNC"
    "3:0:D-F:$CMD_ADB_DEVICES"

    # ── Workspace 5: dotfiles ─────────────────────────────────────────────────
    "5:0:Q-S:$CMD_CLAUDE_DOTFILES"
    "5:0:E-F:$CMD_DOTFILES_STATUS"

    # ── Workspace 6: browser ──────────────────────────────────────────────────
    "6:0:Q-F:$CMD_BROWSER_MAIL"
)

declare -A DEFAULT_LAYOUT_BY_MONITORS=(
    [1]="single"
    [2]="dual"
)

# Grid dimensions (match your Tactile layout)
GRID_COLS=4
GRID_ROWS=2

# Seconds to wait for each window to appear after launch
WINDOW_WAIT_TIMEOUT=15

# Seconds to wait for windows to actually close during --reset / --reset-all / --all
CLOSE_WAIT_TIMEOUT=60

# Seconds to let an easy window close before --close-all-windows gives up on it
CLOSE_GRACE=1

# Pause between positioning operations (seconds)
OP_DELAY=0.05

# Gap between tiled windows in pixels (0 = edge-to-edge)
TILE_GAP=0

# Verify each tiled placement and re-apply if it drifted (belt-and-braces for
# apps that finish mapping late); attempts and settle time between them
PLACEMENT_ATTEMPTS=3
PLACEMENT_SETTLE=0.4

# ══════════════════════════════════════════════════════════════════════════════
#                               INTERNALS
# ══════════════════════════════════════════════════════════════════════════════

EXT_UUID="ajay-workspace-setup-helper@local"
EXT_DIR="$HOME/.local/share/gnome-shell/extensions/$EXT_UUID"
EXT_EXPECTED_VERSION=4
DBUS_DEST="org.gnome.Shell"
DBUS_PATH="/org/gnome/Shell/Extensions/AjayWorkspaceSetup"
DBUS_IFACE="org.gnome.Shell.Extensions.AjayWorkspaceSetup"

# Older UUIDs of this extension, disabled and deleted when found.
LEGACY_EXT_UUIDS=("workspace-setup@local")

declare -A KEY_COL=([Q]=0 [W]=1 [E]=2 [R]=3 [A]=0 [S]=1 [D]=2 [F]=3)
declare -A KEY_ROW=([Q]=0 [W]=0 [E]=0 [R]=0 [A]=1 [S]=1 [D]=1 [F]=1)

MONITORS_JSON=""
MON_COUNT=0
STATE_FILE="$HOME/.cache/ajay-workspace-setup-windows"
LEGACY_STATE_FILE="$HOME/.cache/workspace-setup-windows"

log()  { printf '[workspace-setup] %s\n' "$*" >&2; }
warn() { printf '[workspace-setup] WARNING: %s\n' "$*" >&2; }
die()  { printf '[workspace-setup] ERROR: %s\n' "$*" >&2; exit 1; }

# Comma-separated, lowercase list of declared LAYOUT_<NAME> arrays.
list_layouts() {
    compgen -A variable | sed -n 's/^LAYOUT_\(.*\)/\1/p' | tr '[:upper:]' '[:lower:]' | paste -sd, -
}

# ── Dependency checks ─────────────────────────────────────────────────────────

check_deps() {
    local missing=()
    command -v jq               &>/dev/null || missing+=(jq)
    command -v gdbus            &>/dev/null || missing+=(glib2)
    command -v gnome-extensions &>/dev/null || missing+=(gnome-shell)
    if (( ${#missing[@]} )); then
        die "Missing package(s): ${missing[*]}.  Install with:  sudo dnf install ${missing[*]}"
    fi
}

# ── D-Bus helpers ─────────────────────────────────────────────────────────────

dbus_call() {
    local method="$1"; shift
    local result
    if ! result=$(gdbus call --session \
            --dest "$DBUS_DEST" \
            --object-path "$DBUS_PATH" \
            --method "$DBUS_IFACE.$method" \
            -- "$@" 2>&1); then
        warn "D-Bus call $method failed: $result"
        return 1
    fi
    echo "$result"
}

# Call a method whose single out-arg is a JSON string.
dbus_json() {
    local raw
    raw=$(dbus_call "$@") || return 1
    # Strip the GVariant tuple wrapper: (<string>,). g_variant_print() single-quotes
    # unless the payload holds an apostrophe, and escapes only \ and the quote it
    # picked — so in the single-quoted form JSON's \" arrives as \\". Re-escape the
    # bare " and both forms are JSON string literals jq can decode; stripping the
    # quotes by hand instead leaves the doubled backslashes behind, so any window
    # whose title holds a double quote (browser tabs routinely do) stops being JSON.
    raw="${raw#\(}"
    raw="${raw%,\)}"
    if [[ "$raw" != \"*\" ]]; then
        raw="${raw#\'}"
        raw="${raw%\'}"
        raw="\"${raw//\"/\\\"}\""
    fi
    jq -r . <<< "$raw"
}

# Decoded ListWindows array. Returns non-zero rather than letting a jq parse error
# escape, so one unreadable payload degrades a single placement instead of taking
# the whole run down through set -e.
list_windows() {
    local json
    json=$(dbus_json ListWindows) || return 1
    jq -c . <<< "$json" 2>/dev/null \
        || { warn "Unparseable window list from the shell extension."; return 1; }
}

# ── Extension installation ────────────────────────────────────────────────────

install_extension() {
    log "Installing GNOME Shell extension: $EXT_UUID"
    mkdir -p "$EXT_DIR"

    # Cover GJS-ESM era (shell 45+) up through the running shell. Computed
    # at install time so a GNOME upgrade self-heals on next run instead of
    # leaving the extension stuck OUT OF DATE.
    local shell_major max_major versions_json
    shell_major=$(gnome-shell --version | awk '{print $3}' | cut -d. -f1)
    max_major=$shell_major
    (( max_major < 48 )) && max_major=48
    versions_json=$(seq 45 "$max_major" | sed 's/.*/"&"/' | paste -sd, -)

    # ── metadata.json ─────────────────────────────────────────────────────────
    cat > "$EXT_DIR/metadata.json" << METADATA
{
    "uuid": "ajay-workspace-setup-helper@local",
    "name": "ajay-workspace-setup-helper",
    "description": "D-Bus interface for programmatic window positioning",
    "shell-version": [$versions_json],
    "version": 4
}
METADATA

    # ── extension.js ──────────────────────────────────────────────────────────
    cat > "$EXT_DIR/extension.js" << 'EXTJS'
import Gio from 'gi://Gio';
import Meta from 'gi://Meta';
import {Extension} from 'resource:///org/gnome/shell/extensions/extension.js';

const IFACE = `
<node>
  <interface name="org.gnome.Shell.Extensions.AjayWorkspaceSetup">
    <method name="GetMonitors">
      <arg type="s" direction="out" name="result"/>
    </method>
    <method name="ListWindows">
      <arg type="s" direction="out" name="result"/>
    </method>
    <method name="MoveResize">
      <arg type="u" direction="in" name="windowId"/>
      <arg type="i" direction="in" name="x"/>
      <arg type="i" direction="in" name="y"/>
      <arg type="i" direction="in" name="width"/>
      <arg type="i" direction="in" name="height"/>
      <arg type="b" direction="out" name="success"/>
    </method>
    <method name="MoveToWorkspace">
      <arg type="u" direction="in" name="windowId"/>
      <arg type="i" direction="in" name="workspaceIndex"/>
      <arg type="b" direction="out" name="success"/>
    </method>
    <method name="Maximize">
      <arg type="u" direction="in" name="windowId"/>
      <arg type="b" direction="out" name="success"/>
    </method>
    <method name="Unmaximize">
      <arg type="u" direction="in" name="windowId"/>
      <arg type="b" direction="out" name="success"/>
    </method>
    <method name="ActivateWorkspace">
      <arg type="i" direction="in" name="workspaceIndex"/>
      <arg type="b" direction="out" name="success"/>
    </method>
    <method name="CloseWindow">
      <arg type="u" direction="in" name="windowId"/>
      <arg type="b" direction="out" name="success"/>
    </method>
    <method name="FocusWindow">
      <arg type="u" direction="in" name="windowId"/>
      <arg type="b" direction="out" name="success"/>
    </method>
    <method name="GetFocusedWindowId">
      <arg type="u" direction="out" name="windowId"/>
    </method>
  </interface>
</node>
`;

export default class AjayWorkspaceSetupExtension extends Extension {
    enable() {
        this._dbus = Gio.DBusExportedObject.wrapJSObject(IFACE, this);
        this._dbus.export(
            Gio.DBus.session,
            '/org/gnome/Shell/Extensions/AjayWorkspaceSetup'
        );
    }

    disable() {
        this._dbus?.unexport();
        this._dbus = null;
    }

    _findWindow(id) {
        for (const actor of global.get_window_actors()) {
            if (actor.meta_window.get_stable_sequence() === id)
                return actor.meta_window;
        }
        return null;
    }

    GetMonitors() {
        const display = global.display;
        const ws = global.workspace_manager.get_active_workspace();
        const n = display.get_n_monitors();
        const result = [];
        for (let i = 0; i < n; i++) {
            const geo = display.get_monitor_geometry(i);
            const wa = ws.get_work_area_for_monitor(i);
            result.push({
                index: i,
                x: geo.x, y: geo.y,
                width: geo.width, height: geo.height,
                workArea: {
                    x: wa.x, y: wa.y,
                    width: wa.width, height: wa.height,
                },
                isPrimary: display.get_primary_monitor() === i,
            });
        }
        return JSON.stringify(result);
    }

    ListWindows() {
        return JSON.stringify(
            global.get_window_actors()
                .filter(a =>
                    a.meta_window.get_window_type() === Meta.WindowType.NORMAL
                )
                .map(a => {
                    const w = a.meta_window;
                    const r = w.get_frame_rect();
                    return {
                        id: w.get_stable_sequence(),
                        title: w.get_title() || '',
                        wmClass: w.get_wm_class() || '',
                        workspace: w.get_workspace()?.index() ?? -1,
                        x: r.x, y: r.y,
                        width: r.width, height: r.height,
                    };
                })
        );
    }

    MoveResize(id, x, y, w, h) {
        const win = this._findWindow(id);
        if (!win) return false;
        if (win.get_maximize_flags()) win.unmaximize(Meta.MaximizeFlags.BOTH);

        // Wayland clients can't be reliably moved across monitors via
        // move_resize_frame alone — relocate explicitly first, then size.
        const display = global.display;
        const n = display.get_n_monitors();
        let targetMon = -1;
        for (let i = 0; i < n; i++) {
            const g = display.get_monitor_geometry(i);
            if (x >= g.x && x < g.x + g.width &&
                    y >= g.y && y < g.y + g.height) {
                targetMon = i;
                break;
            }
        }
        if (targetMon >= 0 && win.get_monitor() !== targetMon)
            win.move_to_monitor(targetMon);

        // user_op=true: mark as a user placement so mutter's auto-placement
        // won't re-center the window once a slow app finishes mapping.
        win.move_resize_frame(true, x, y, w, h);
        return true;
    }

    MoveToWorkspace(id, idx) {
        const win = this._findWindow(id);
        if (!win) return false;
        win.change_workspace_by_index(idx, false);
        return true;
    }

    Maximize(id) {
        const win = this._findWindow(id);
        if (!win) return false;
        win.maximize(Meta.MaximizeFlags.BOTH);
        return true;
    }

    Unmaximize(id) {
        const win = this._findWindow(id);
        if (!win) return false;
        win.unmaximize(Meta.MaximizeFlags.BOTH);
        return true;
    }

    ActivateWorkspace(idx) {
        const ws = global.workspace_manager.get_workspace_by_index(idx);
        if (!ws) return false;
        ws.activate(global.get_current_time());
        return true;
    }

    CloseWindow(id) {
        const win = this._findWindow(id);
        if (!win) return false;
        win.delete(global.get_current_time());
        return true;
    }

    FocusWindow(id) {
        const win = this._findWindow(id);
        if (!win) return false;
        const ws = win.get_workspace();
        if (ws) ws.activate(global.get_current_time());
        win.activate(global.get_current_time());
        return true;
    }

    GetFocusedWindowId() {
        const win = global.display.focus_window;
        return win ? win.get_stable_sequence() : 0;
    }
}
EXTJS

    log "Extension files written to $EXT_DIR"

    gnome-extensions enable "$EXT_UUID" 2>/dev/null || true
    sleep 2

    log "Extension installed and enabled."
    log "If this is the first install you may need to log out and back in."
}

# ── Legacy cleanup & extension readiness ──────────────────────────────────────

cleanup_legacy_extensions() {
    local uuid legacy_dir
    for uuid in "${LEGACY_EXT_UUIDS[@]}"; do
        legacy_dir="$HOME/.local/share/gnome-shell/extensions/$uuid"
        if [[ -d "$legacy_dir" ]]; then
            log "Removing legacy extension: $uuid"
            gnome-extensions disable "$uuid" 2>/dev/null || true
            rm -rf -- "$legacy_dir"
        fi
    done
}

check_extension() {
    cleanup_legacy_extensions

    if [[ ! -d "$EXT_DIR" ]]; then
        install_extension
    fi

    local state
    state=$(gnome-extensions show "$EXT_UUID" 2>/dev/null \
        | grep -oP 'State: \K.*' || echo "NOT_FOUND")

    # OUT OF DATE typically means a GNOME Shell upgrade since the extension
    # was installed. Refresh the on-disk metadata so the next Shell load
    # picks up the new shell-version, but the running Shell will not re-read
    # metadata.json without a restart — and on Wayland that means a logout.
    if [[ "$state" == "OUT"* ]]; then
        log "Extension state: $state — refreshing metadata on disk..."
        install_extension
        die "Extension metadata updated for GNOME Shell $(gnome-shell --version | awk '{print $3}').
  GNOME does not re-read extension metadata while running, so you must:
    log out and back in (Wayland), then re-run this script."
    fi

    # If the on-disk extension code is older than what this script expects,
    # write the new files and force a logout — GNOME doesn't re-read extension
    # JS while running, so the in-memory copy is stale even after `enable`.
    local installed_version
    installed_version=$(jq -r '.version // 0' "$EXT_DIR/metadata.json" 2>/dev/null || echo 0)
    if (( installed_version < EXT_EXPECTED_VERSION )); then
        log "Extension version $installed_version found, expected $EXT_EXPECTED_VERSION — refreshing on disk..."
        install_extension
        die "Extension files updated to version $EXT_EXPECTED_VERSION.
  GNOME does not re-read extension code while running, so you must:
    log out and back in (Wayland), then re-run this script."
    fi

    if [[ "$state" != "ACTIVE" && "$state" != "ENABLED" ]]; then
        log "Extension state: $state — attempting to enable..."
        gnome-extensions enable "$EXT_UUID" 2>/dev/null || true
        sleep 2
        state=$(gnome-extensions show "$EXT_UUID" 2>/dev/null \
            | grep -oP 'State: \K.*' || echo "NOT_FOUND")
        if [[ "$state" != "ACTIVE" && "$state" != "ENABLED" ]]; then
            die "Extension could not be activated (state: $state).
  Try logging out and back in, then run this script again."
        fi
    fi

    if ! dbus_json GetMonitors &>/dev/null; then
        die "Extension is enabled but its D-Bus API is not responding.
  Try logging out and back in, then run this script again."
    fi

    log "Extension is active."
}

# ── Monitor detection ─────────────────────────────────────────────────────────

detect_monitors() {
    MONITORS_JSON=$(dbus_json GetMonitors | jq 'sort_by(.x)') \
        || die "Could not read the monitor list from the shell extension."
    MON_COUNT=$(echo "$MONITORS_JSON" | jq 'length')

    if (( MON_COUNT == 0 )); then
        die "No monitors detected."
    fi

    local i
    for (( i = 0; i < MON_COUNT; i++ )); do
        log "$(echo "$MONITORS_JSON" | jq -r --argjson i "$i" '
            .[$i] |
            "Monitor \($i): \(.width)x\(.height)+\(.x)+\(.y)" +
            "  work-area \(.workArea.width)x\(.workArea.height)" +
            "+\(.workArea.x)+\(.workArea.y)" +
            (if .isPrimary then "  [primary]" else "" end)
        ')"
    done
    log "$MON_COUNT monitor(s) detected."
}

# ── Tactile grid → pixel geometry ─────────────────────────────────────────────

# Print "X Y W H" for a grid position on a given (sorted) monitor index.
tactile_to_geometry() {
    local pos="$1" mon="$2"

    local start="${pos%-*}" end="${pos#*-}"
    start="${start^^}"; end="${end^^}"

    if [[ -z "${KEY_COL[$start]+_}" || -z "${KEY_COL[$end]+_}" ]]; then
        die "Invalid grid key in position '$pos'"
    fi

    local c1=${KEY_COL[$start]} r1=${KEY_ROW[$start]}
    local c2=${KEY_COL[$end]}   r2=${KEY_ROW[$end]}
    if (( c1 > c2 )); then local t=$c1; c1=$c2; c2=$t; fi
    if (( r1 > r2 )); then local t=$r1; r1=$r2; r2=$t; fi

    local wa_x wa_y wa_w wa_h
    read -r wa_x wa_y wa_w wa_h <<< "$(echo "$MONITORS_JSON" | \
        jq -r ".[$mon].workArea | \"\(.x) \(.y) \(.width) \(.height)\"")"

    local cell_w=$(( wa_w / GRID_COLS ))
    local cell_h=$(( wa_h / GRID_ROWS ))

    local win_x=$(( wa_x + c1 * cell_w + TILE_GAP ))
    local win_y=$(( wa_y + r1 * cell_h + TILE_GAP ))
    local win_w=$(( (c2 - c1 + 1) * cell_w - 2 * TILE_GAP ))
    local win_h=$(( (r2 - r1 + 1) * cell_h - 2 * TILE_GAP ))

    echo "$win_x $win_y $win_w $win_h"
}

# True if the position covers the entire grid.
is_fullscreen_position() {
    local pos="$1"
    local start="${pos%-*}" end="${pos#*-}"
    start="${start^^}"; end="${end^^}"

    local c1=${KEY_COL[$start]} r1=${KEY_ROW[$start]}
    local c2=${KEY_COL[$end]}   r2=${KEY_ROW[$end]}
    if (( c1 > c2 )); then local t=$c1; c1=$c2; c2=$t; fi
    if (( r1 > r2 )); then local t=$r1; r1=$r2; r2=$t; fi

    (( c2 - c1 + 1 == GRID_COLS && r2 - r1 + 1 == GRID_ROWS ))
}

# ── Window management ─────────────────────────────────────────────────────────

# Launch $1, wait for a new window, print its id.
launch_and_find_window() {
    local cmd="$1"
    # No fallback here: an empty "before" snapshot would make every pre-existing
    # window look new and get tiled in place of the one being launched.
    local before_json
    if ! before_json=$(list_windows | jq '[.[].id]'); then
        warn "Could not snapshot the window list. Skipping: $cmd"
        return 1
    fi

    log "Launching: $cmd"
    eval "$cmd" &>/dev/null &
    disown

    local new_id="" elapsed=0
    while [[ -z "$new_id" ]] && (( elapsed < WINDOW_WAIT_TIMEOUT * 10 )); do
        sleep 0.1
        (( ++elapsed ))
        new_id=$(list_windows | jq -r \
            --argjson before "$before_json" \
            '[.[].id] - $before | .[0] // empty') || new_id=""
    done

    if [[ -z "$new_id" ]]; then
        warn "Timed out (${WINDOW_WAIT_TIMEOUT}s) waiting for window: $cmd"
        return 1
    fi

    local elapsed_ms=$(( elapsed * 100 ))
    log "  window $new_id appeared (${elapsed_ms}ms)"
    echo "$new_id"
}

# Print "X Y W H" for a window id; empty if the window is gone.
window_rect() {
    list_windows | jq -r --argjson id "$1" \
        '.[] | select(.id == $id) | "\(.x) \(.y) \(.width) \(.height)"'
}

# Place a window at a Tactile grid position on a sorted monitor index.
position_window() {
    local wid="$1" pos="$2" mon="$3"

    if is_fullscreen_position "$pos"; then
        # Move first: Maximize acts on whichever monitor the window is already on.
        local wa_x wa_y wa_w wa_h
        wa_x=$(echo "$MONITORS_JSON" | jq ".[$mon].workArea.x")
        wa_y=$(echo "$MONITORS_JSON" | jq ".[$mon].workArea.y")
        wa_w=$(echo "$MONITORS_JSON" | jq ".[$mon].workArea.width")
        wa_h=$(echo "$MONITORS_JSON" | jq ".[$mon].workArea.height")
        dbus_call MoveResize "$wid" "$wa_x" "$wa_y" "$wa_w" "$wa_h" >/dev/null
        sleep "$OP_DELAY"
        dbus_call Maximize "$wid" >/dev/null
    else
        local x y w h want actual attempt
        read -r x y w h <<< "$(tactile_to_geometry "$pos" "$mon")"
        want="$x $y $w $h"
        for (( attempt = 1; attempt <= PLACEMENT_ATTEMPTS; attempt++ )); do
            dbus_call MoveResize "$wid" "$x" "$y" "$w" "$h" >/dev/null
            sleep "$PLACEMENT_SETTLE"
            actual=$(window_rect "$wid") || actual=""
            if [[ "$actual" == "$want" ]]; then
                break
            fi
            if (( attempt < PLACEMENT_ATTEMPTS )); then
                log "  $pos drifted to ${actual:-gone}, re-placing"
            fi
        done
        if [[ "$actual" != "$want" ]]; then
            warn "$pos did not hold (want '$want', got '${actual:-gone}')"
        fi
    fi

    log "  positioned $pos on monitor $mon"
}

# ── Workspace management ──────────────────────────────────────────────────────

# Verify the system has enough workspaces for the layout; never changes it.
check_workspaces() {
    local needed="$1"
    local have
    have=$(gsettings get org.gnome.desktop.wm.preferences num-workspaces 2>/dev/null \
        | tr -d ' ') || have=""
    local dynamic
    dynamic=$(gsettings get org.gnome.mutter dynamic-workspaces 2>/dev/null \
        | tr -d ' ') || dynamic=""

    if [[ "$dynamic" == "true" ]]; then
        # Dynamic workspaces — GNOME creates them on demand, nothing to check.
        return
    fi

    if [[ -n "$have" ]] && (( have < needed )); then
        die "Layout requires $needed workspace(s) but only $have configured.
  Fix with:  gsettings set org.gnome.desktop.wm.preferences num-workspaces $needed"
    fi
}

# ── Reset ─────────────────────────────────────────────────────────────────────

# Save a window id to the state file so --reset can close it later.
track_window() {
    local wid="$1"
    mkdir -p "$(dirname "$STATE_FILE")"
    echo "$wid" >> "$STATE_FILE"
}

# Print the ids of all NORMAL windows, excluding $1 (-1 excludes none).
list_window_ids() {
    list_windows | jq -r --argjson ex "${1:--1}" '.[] | select(.id != $ex) | .id'
}

# close_windows <timeout-seconds> <die|report> <id>...
# Close the given ids and poll until they are gone. An unsaved-changes prompt
# blocks CloseWindow, so survivors either abort the run or are reported and the
# function returns 1, per the second argument.
close_windows() {
    local timeout="$1" on_survivors="$2"; shift 2
    local -a ids=("$@")
    (( ${#ids[@]} )) || return 0

    local want
    want=$(printf '%s\n' "${ids[@]}" | jq -Rs '[split("\n")[] | select(length > 0) | tonumber]')

    # Requested ids that are still live, via jq array subtraction.
    local live_query='[.[].id] as $live | $want - ($want - $live) | .[]'

    # Narrow to what is actually open — the state file can hold stale ids.
    local -a alive=()
    mapfile -t alive < <(list_windows | jq -r --argjson want "$want" "$live_query")
    if (( ${#alive[@]} == 0 )); then
        log "No matching windows still open."
        return 0
    fi

    local closing=${#alive[@]} wid
    for wid in "${alive[@]}"; do
        dbus_call CloseWindow "$wid" &>/dev/null || true
    done

    local elapsed=0
    while :; do
        mapfile -t alive < <(list_windows | jq -r --argjson want "$want" "$live_query")
        if (( ${#alive[@]} == 0 )); then break; fi
        if (( elapsed >= timeout * 10 )); then break; fi
        sleep 0.1
        (( ++elapsed ))
    done

    if (( ${#alive[@]} > 0 )); then
        local listing
        listing=$(list_windows | jq -r --argjson want "$want" \
            '.[] | select(.id as $i | $want | index($i)) | "    \(.wmClass): \(.title)"') \
            || listing="    (window list unavailable)"
        if [[ "$on_survivors" == die ]]; then
            die "Timed out after ${timeout}s — ${#alive[@]} window(s) would not close:
$listing
  An unsaved-changes prompt blocks CloseWindow. Close them by hand, then re-run."
        fi
        warn "${#alive[@]} window(s) still open after ${timeout}s:
$listing"
        log "Closed $(( closing - ${#alive[@]} )) window(s)."
        return 1
    fi

    log "Closed $closing window(s)."
}

reset_windows() {
    if [[ ! -f "$STATE_FILE" ]]; then
        log "No previous session to reset (no state file)."
        return
    fi
    local -a ids=()
    mapfile -t ids < <(grep -E '^[0-9]+$' "$STATE_FILE" || true)
    if (( ${#ids[@]} == 0 )); then
        log "No tracked windows to close."
        return
    fi
    log "Closing windows from previous session..."
    close_windows "$CLOSE_WAIT_TIMEOUT" die "${ids[@]}"
}

reset_all_windows() {
    local -a ids=()
    mapfile -t ids < <(list_window_ids "${1:--1}")
    if (( ${#ids[@]} == 0 )); then
        log "No windows to close."
        return
    fi
    log "Closing ALL ${#ids[@]} window(s)..."
    close_windows "$CLOSE_WAIT_TIMEOUT" die "${ids[@]}"
}

# close_all_windows <launcher-id> <wait-all> <close-self>
# Close every window and stop. The launcher goes last and only if everything
# else closed, so a survivor listing is never taken down with the terminal that
# printed it.
close_all_windows() {
    local keep="${1:--1}" wait_all="$2" close_self="$3"
    local survived=0

    local -a ids=()
    mapfile -t ids < <(list_window_ids "$keep")
    if (( ${#ids[@]} == 0 )); then
        log "No windows to close."
    else
        log "Closing ${#ids[@]} window(s)..."
        if (( wait_all )); then
            close_windows "$CLOSE_WAIT_TIMEOUT" die "${ids[@]}"
        else
            close_windows "$CLOSE_GRACE" report "${ids[@]}" || survived=1
        fi
    fi

    if (( ! close_self )); then
        return 0
    fi
    if (( survived )); then
        log "Leaving this terminal open so the list above stays readable."
        return 0
    fi
    if [[ "$keep" == -1 ]]; then
        return 0
    fi
    log "Closing this terminal."
    dbus_call CloseWindow "$keep" &>/dev/null || true
}

# ── Main ──────────────────────────────────────────────────────────────────────

main() {
    local do_reset=0 do_reset_all=0 install_only=0
    local close_all=0 wait_all=0 close_self=-1
    local requested_layout=""

    while (( $# > 0 )); do
        case "$1" in
            --reset)     do_reset=1 ;;
            --reset-all) do_reset_all=1 ;;
            --close-all-windows) close_all=1 ;;
            --all)       wait_all=1 ;;
            --self)      close_self=1 ;;
            --no-self)   close_self=0 ;;
            --install)   install_only=1 ;;
            --layout)
                shift
                (( $# > 0 )) || die "--layout requires a value (available: $(list_layouts))"
                requested_layout="$1"
                ;;
            --layout=*) requested_layout="${1#--layout=}" ;;
            --help|-h)
                sed -n '2,/^[^#]/{ /^#/s/^# \?//p }' "$0"
                exit 0
                ;;
            *) die "Unknown option: $1  (use --help)" ;;
        esac
        shift
    done

    if (( ! close_all )) && { (( wait_all )) || (( close_self >= 0 )); }; then
        die "--all / --self / --no-self only apply with --close-all-windows"
    fi
    # --all closes the launcher too unless told otherwise.
    (( close_self >= 0 )) || close_self=$(( wait_all ))

    check_deps

    # One-shot migration of the previous-session window-tracking cache.
    if [[ -e "$LEGACY_STATE_FILE" && ! -e "$STATE_FILE" ]]; then
        mv "$LEGACY_STATE_FILE" "$STATE_FILE"
    fi

    if (( install_only )); then
        install_extension
        exit 0
    fi

    check_extension

    # Remember the launching terminal so we can refocus (or close) it at the end.
    local launcher_wid
    launcher_wid=$(dbus_call GetFocusedWindowId 2>/dev/null \
        | sed -n 's/.* \([0-9]\+\),.*/\1/p') || launcher_wid=""

    if (( close_all )); then
        close_all_windows "${launcher_wid:--1}" "$wait_all" "$close_self"
        exit 0
    fi

    detect_monitors

    local layout_name="$requested_layout"
    if [[ -z "$layout_name" ]]; then
        layout_name="${DEFAULT_LAYOUT_BY_MONITORS[$MON_COUNT]:-}"
        [[ -n "$layout_name" ]] \
            || die "No default layout for $MON_COUNT monitor(s). Pass --layout NAME (available: $(list_layouts)) or add [$MON_COUNT]=... to DEFAULT_LAYOUT_BY_MONITORS."
        log "Auto-selected layout '$layout_name' for $MON_COUNT monitor(s)."
    else
        log "Using layout '$layout_name' (--layout)."
    fi

    local layout_var="LAYOUT_${layout_name^^}"
    declare -p "$layout_var" &>/dev/null \
        || die "Unknown layout '$layout_name'. Available: $(list_layouts)"
    local -n LAYOUT="$layout_var"
    (( ${#LAYOUT[@]} > 0 )) \
        || die "Layout '$layout_name' is empty. Edit $layout_var in $0."

    if (( do_reset_all )); then
        reset_all_windows "${launcher_wid:--1}"
    elif (( do_reset )); then
        reset_windows
    fi

    rm -f "$STATE_FILE"

    local max_ws=1
    for entry in "${LAYOUT[@]}"; do
        IFS=: read -r ws _ _ _ <<< "$entry"
        (( ws > max_ws )) && max_ws=$ws
    done
    check_workspaces "$max_ws"

    local ws
    for (( ws = 1; ws <= max_ws; ws++ )); do
        local -a ws_entries=()
        for entry in "${LAYOUT[@]}"; do
            IFS=: read -r ews _ _ _ <<< "$entry"
            (( ews == ws )) && ws_entries+=("$entry")
        done
        (( ${#ws_entries[@]} == 0 )) && continue

        log "── Workspace $ws ──"
        dbus_call ActivateWorkspace "$(( ws - 1 ))" >/dev/null || true
        sleep "$OP_DELAY"

        for entry in "${ws_entries[@]}"; do
            IFS=: read -r _ mon pos cmd <<< "$entry"

            if (( mon >= MON_COUNT )); then
                warn "Monitor $mon not available (have $MON_COUNT). Skipping: $cmd"
                continue
            fi

            local wid
            if ! wid=$(launch_and_find_window "$cmd"); then
                continue
            fi

            dbus_call MoveToWorkspace "$wid" "$(( ws - 1 ))" >/dev/null || true

            position_window "$wid" "$pos" "$mon"
            track_window "$wid"
        done
    done

    if [[ -n "$launcher_wid" && "$launcher_wid" != "0" ]]; then
        sleep 0.1
        dbus_call FocusWindow "$launcher_wid" >/dev/null || true
    else
        dbus_call ActivateWorkspace 0 >/dev/null || true
    fi
    log "Done.  Layout is ready."
}

main "$@"
